<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="9dp" android:gravity="center_vertical">
    <LinearLayout android:id="@+id/main" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:id="@+id/icon" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#E9E9ED" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#E9E9ED" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"  android:text="3h 12m"/>
<Chronometer android:id="@+id/chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#E9E9ED" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"  android:visibility="gone"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="7dp" android:max="1000" android:progress="600" android:progressDrawable="@drawable/w_progress"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="11sp" android:maxLines="1"/>
    </LinearLayout>
    <ImageView android:id="@+id/log" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="10dp" android:padding="10dp" android:background="@drawable/w_circle_n700" android:contentDescription="Log slip"/>
</LinearLayout>
