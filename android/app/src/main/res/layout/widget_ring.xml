<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_surface">
<LinearLayout android:id="@+id/body" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
    <FrameLayout android:layout_width="92dp" android:layout_height="92dp">
        <ImageView android:id="@+id/ring" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <ImageView android:id="@+id/icon" android:layout_width="16dp" android:layout_height="16dp"/>
            <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#E9E9ED" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"  android:text="3h 12m"/>
<Chronometer android:id="@+id/chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#E9E9ED" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"  android:visibility="gone"/>
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="11.5sp" android:textColor="#D2CEFD" android:maxLines="1" android:text="Beaten ✓"/>
</LinearLayout>
<include android:id="@+id/empty" layout="@layout/widget_empty" android:visibility="gone"/>
</FrameLayout>
