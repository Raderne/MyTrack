<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_surface">
<LinearLayout android:id="@+id/body" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingVertical="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/main" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:id="@+id/icon" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#B2B6CA" android:maxLines="1" android:ellipsize="end" android:text="Sugar · since last slip"/>
            </LinearLayout>
            <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="32sp" android:textColor="#E9E9ED" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" android:layout_marginTop="4dp" android:text="3h 12m"/>
<Chronometer android:id="@+id/chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="32sp" android:textColor="#E9E9ED" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1" android:layout_marginTop="4dp" android:visibility="gone"/>
        </LinearLayout>
        <ImageView android:id="@+id/log" android:layout_width="52dp" android:layout_height="52dp" android:padding="16dp" android:background="@drawable/w_circle_accent" android:contentDescription="Log slip"/>
    </LinearLayout>
    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
    <ProgressBar android:id="@+id/bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"  android:max="1000" android:progress="600" android:progressDrawable="@drawable/w_progress"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp">
        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="11.5sp" android:textColor="#EF9497" android:maxLines="1" android:ellipsize="end" android:text="1h 05m left or it's a fail"/>
        <TextView android:id="@+id/target" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5sp" android:textColor="#9397AB" android:maxLines="1" android:text="Last 4h 10m"/>
    </LinearLayout>
</LinearLayout>
<include android:id="@+id/empty" layout="@layout/widget_empty" android:visibility="gone"/>
</FrameLayout>
