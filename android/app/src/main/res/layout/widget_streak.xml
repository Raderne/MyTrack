<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_section">
<LinearLayout android:id="@+id/body" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/flame" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="6dp"/>
        <TextView android:id="@+id/streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="30sp" android:textColor="#E7E5FE" android:fontFamily="sans-serif-medium" android:text="4"/>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#E7E5FE" android:text="longer in a row"/>
    <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#F3F5FE" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"  android:text="3h 12m"/>
<Chronometer android:id="@+id/chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#F3F5FE" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"  android:visibility="gone"/>
    <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#E7E5FE" android:maxLines="1" android:ellipsize="end" android:text="Smoking"/>
</LinearLayout>
<include android:id="@+id/empty" layout="@layout/widget_empty" android:visibility="gone"/>
</FrameLayout>
